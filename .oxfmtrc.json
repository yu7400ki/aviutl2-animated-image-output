{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "printWidth": 100,
  "sortImports": true,
  "sortPackageJson": true,
  "ignorePatterns": [
    "**/vendor/**",
    "*.md",
    "*.toml",
    "*.hbs",
    "*.yml",
    "*.yaml"
  ]
}
